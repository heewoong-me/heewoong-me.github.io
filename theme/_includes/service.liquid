{% assign service = site.data.service %}
<div class="service">
  <ul style="padding-left: 1.2rem; margin-bottom: 0;">
    {% if service.conferences and service.conferences.size > 0 %}
      <li><b>Conference Reviewer</b>:
        {% for c in service.conferences %}{{ c.venue }} ({{ c.years | join: ", " }}){% if c.note %}, {{ c.note }}{% endif %}{% unless forloop.last %}; {% endunless %}{% endfor %}
      </li>
    {% endif %}
    {% if service.journals and service.journals.size > 0 %}
      <li><b>Journal Reviewer</b>:
        {% for j in service.journals %}{{ j.venue }} ({{ j.years | join: ", " }}){% unless forloop.last %}; {% endunless %}{% endfor %}
      </li>
    {% endif %}
    {% for a in service.awards %}
      {% assign parts = a.text | split: ": " %}
      {% if parts.size > 1 %}{% assign label = parts[0] %}{% assign rest = a.text | remove_first: label | remove_first: ": " %}{% else %}{% assign label = "" %}{% assign rest = a.text %}{% endif %}
      <li>{% if a.url %}<a href="{{ a.url }}" target="_blank" rel="external nofollow noopener">{% endif %}{% if label != "" %}<b>{{ label }}</b>: {% endif %}{{ rest }}{% if a.url %}</a>{% endif %}</li>
    {% endfor %}
  </ul>
</div>
